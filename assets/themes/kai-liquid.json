{
  "name": "kai-liquid",
  "schema_version": 7,
  "variables": {
    "bg": "#080b14",
    "alt_bg": "#101627",
    "fg": "#eef4ff",
    "alt_fg": "#a7c4e6",
    "sel_bg": "#1d2a44",
    "sel_fg": "#ffffff",
    "accent_color": "#5ee7ff",
    "muted_fg": "#9db4d4",
    "border_color": "#33507a",
    "hover_bg": "#15203a",
    "surface": "#111a2e",
    "surface_2": "#1a2740",
    "terminal_bg": "#060911",
    "terminal_fg": "#eef4ff",
    "code_bg": "#0b1120",
    "code_fg": "#eef4ff",
    "code_border": "#33507a",
    "success_fg": "#5df2b0",
    "error_fg": "#ff6b81",
    "warning_fg": "#ffd166",
    "info_fg": "#5ee7ff",
    "danger_bg": "#e63958",
    "radius_sm": "8px",
    "radius_md": "14px",
    "radius_lg": "22px",
    "border_radius": "14px",
    "font_family": "Ubuntu",
    "font_size": "12pt",
    "mono_family": "'JetBrains Mono','Cascadia Code','Fira Code','Ubuntu Mono',Consolas,monospace",
    "title_weight": "600",
    "edit_bg": "#0b1120",
    "edit_fg": "#eef4ff",
    "notes_bg": "#1a2740",
    "notes_fg": "#a7c4e6",
    "notification_bg": "#1a2740",
    "notification_fg": "#eef4ff",
    "num_fg": "#5ee7ff",
    "find_fg": "#ffd166",
    "gradient_primary_start": "#080b14",
    "gradient_primary_end": "#1a2740",
    "gradient_primary_angle": "160",
    "gradient_secondary_start": "#1a2740",
    "gradient_secondary_end": "#25465f",
    "gradient_secondary_angle": "135",
    "gradient_tertiary_start": "#5ee7ff",
    "gradient_tertiary_end": "#a78bfa",
    "gradient_tertiary_angle": "135"
  },
  "components": {
    "main_window": "background: ${bg}; color: ${fg};",
    "menu_bar": "background: ${bg}; color: ${fg};",
    "menu_bar_selected": "background: ${sel_bg}; color: ${sel_fg};",
    "menu_bar_disabled": "color: ${bg + #5a708f};",
    "menu": "border: 1px solid ${border_color}; background: ${surface}; color: ${fg};",
    "tool_bar": "color: ${fg}; background-color: ${bg}; border: 0;",
    "tool_button": "color: ${fg}; background: ${bg}; border: 0; border-radius: 8px;",
    "tool_button_pressed": "background: ${sel_bg};",
    "tool_button_selected": "background: ${hover_bg}; color: ${sel_fg}; border: 1px solid ${border_color};",
    "tab_bar": "background: ${alt_bg};",
    "tab_selected": "padding: 0.5em; background: ${surface}; border: 1px solid ${border_color}; border-bottom: 2px solid ${accent_color}; color: ${fg}; font-weight: 600;",
    "tab_unselected": "border: 1px solid ${alt_bg}; border-bottom: 2px solid ${alt_bg}; padding: 0.5em; background: ${alt_bg}; color: ${muted_fg};",
    "search_bar": "background: ${surface}; color: ${fg}; border: 1px solid ${border_color}; margin: 2px;",
    "search_bar_focused": "border: 1px solid ${accent_color};",
    "item_selected": "background: ${sel_bg}; color: ${sel_fg};",
    "notification": "background: ${notification_bg}; color: ${notification_fg};",
    "tooltip": "background: ${surface_2}; color: ${fg}; border: 1px solid ${border_color};"
  }
}
