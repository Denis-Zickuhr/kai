// Recursos Windows do Kai.
//
// Além do ícone, este arquivo declara VERSIONINFO e embute um MANIFEST.
// Motivo (não é cosmético): um executável nao assinado, SEM informação de
// versão e SEM manifest é um dos perfis que o Windows Defender pontua como
// suspeito na análise heurística/reputacional — foi o caso reportado do
// kai.exe sendo "moído" pelo Defender. Metadados completos e um manifest
// explícito com `asInvoker` (o app não pede elevação) reduzem esse escore.
// O manifest também declara DPI awareness, o que corrige a interface
// borrada em telas HiDPI.

#include <windows.h>

// IDI_ICON1 = 1 é o índice que o Windows usa como ícone principal do app.
IDI_ICON1 ICON "kai.ico"

// O manifest da aplicação (ID 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID).
1 RT_MANIFEST "kai.manifest"

#define KAI_RC_ORIGINAL "kai.exe"
#include "version-info.rc"
