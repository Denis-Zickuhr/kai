{
  "name": "kai-dark",
  "schema_version": 7,
  "variables": {
    "bg": "#0d0e12",
    "alt_bg": "#14161c",
    "fg": "#e6e8ef",
    "alt_fg": "#a9b0c4",
    "sel_bg": "#232735",
    "sel_fg": "#f2f4fa",
    "accent_color": "#6e7bff",
    "muted_fg": "#8b90a0",
    "border_color": "#22252f",
    "hover_bg": "#191c24",
    "surface": "#14161c",
    "surface_2": "#1b1e27",
    "terminal_bg": "#0a0b0e",
    "terminal_fg": "#e6e8ef",
    "code_bg": "#0f1115",
    "code_fg": "#e6e8ef",
    "code_border": "#22252f",
    "success_fg": "#3fb950",
    "error_fg": "#f85149",
    "warning_fg": "#d29922",
    "info_fg": "#58a6ff",
    "danger_bg": "#da3633",
    "radius_sm": "5px",
    "radius_md": "9px",
    "radius_lg": "14px",
    "border_radius": "9px",
    "font_family": "Ubuntu",
    "font_size": "12pt",
    "mono_family": "'JetBrains Mono','Cascadia Code','Fira Code','Ubuntu Mono',Consolas,monospace",
    "title_weight": "600",
    "edit_bg": "#0f1115",
    "edit_fg": "#e6e8ef",
    "notes_bg": "#1b1e27",
    "notes_fg": "#a9b0c4",
    "notification_bg": "#1b1e27",
    "notification_fg": "#e6e8ef",
    "num_fg": "#58a6ff",
    "find_fg": "#d29922",
    "gradient_primary_start": "#0d0e12",
    "gradient_primary_end": "#1b1e27",
    "gradient_primary_angle": "160",
    "gradient_secondary_start": "#1b1e27",
    "gradient_secondary_end": "#282d4a",
    "gradient_secondary_angle": "135",
    "gradient_tertiary_start": "#6e7bff",
    "gradient_tertiary_end": "#22d3ee",
    "gradient_tertiary_angle": "135"
  },
  "components": {
    "main_window": "background: ${bg}; color: ${fg};",
    "menu_bar": "background: ${bg}; color: ${fg};",
    "menu_bar_selected": "background: ${sel_bg}; color: ${sel_fg};",
    "menu_bar_disabled": "color: ${bg + #555a66};",
    "menu": "border: 1px solid ${border_color}; background: ${surface}; color: ${fg};",
    "tool_bar": "color: ${fg}; background-color: ${bg}; border: 0;",
    "tool_button": "color: ${fg}; background: ${bg}; border: 0; border-radius: 5px;",
    "tool_button_pressed": "background: ${sel_bg};",
    "tool_button_selected": "background: ${hover_bg}; color: ${sel_fg}; border: 1px solid ${border_color};",
    "tab_bar": "background: ${alt_bg};",
    "tab_selected": "padding: 0.5em; background: ${bg}; border: 1px solid ${border_color}; border-bottom: 2px solid ${accent_color}; color: ${fg}; font-weight: 600;",
    "tab_unselected": "border: 1px solid ${alt_bg}; border-bottom: 2px solid ${alt_bg}; padding: 0.5em; background: ${alt_bg}; color: ${muted_fg};",
    "search_bar": "background: ${surface}; color: ${fg}; border: 1px solid ${border_color}; margin: 2px;",
    "search_bar_focused": "border: 1px solid ${accent_color};",
    "item_selected": "background: ${sel_bg}; color: ${sel_fg};",
    "notification": "background: ${notification_bg}; color: ${notification_fg};",
    "tooltip": "background: ${surface_2}; color: ${fg}; border: 1px solid ${border_color};"
  }
}
