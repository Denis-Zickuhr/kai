{
  "name": "dracula",
  "schema_version": 7,
  "variables": {
    "bg": "#282a36",
    "alt_bg": "#21222c",
    "fg": "#f8f8f2",
    "alt_fg": "#d6acff",
    "sel_bg": "#44475a",
    "sel_fg": "#f8f8f2",
    "accent_color": "#bd93f9",
    "border_radius": "4px",
    "font_family": "Ubuntu",
    "font_size": "12pt",
    "edit_bg": "#282a36",
    "edit_fg": "#a4ffff",
    "notes_bg": "#44475a",
    "notes_fg": "#d6acff",
    "notification_bg": "#44475a",
    "notification_fg": "#f8f8f2",
    "num_fg": "#a4ffff",
    "find_fg": "#ffffa5",
    "gradient_primary_start": "#282a36",
    "gradient_primary_end": "#21222c",
    "gradient_primary_angle": "160",
    "gradient_secondary_start": "#21222c",
    "gradient_secondary_end": "#3a344d",
    "gradient_secondary_angle": "135",
    "gradient_tertiary_start": "#bd93f9",
    "gradient_tertiary_end": "#ff79c6",
    "gradient_tertiary_angle": "135"
  },
  "components": {
    "main_window": "background: ${bg}; color: ${fg};",
    "menu_bar": "background: ${bg}; color: ${fg};",
    "menu_bar_selected": "background: ${sel_bg}; color: ${sel_fg};",
    "menu_bar_disabled": "color: ${bg - #666666};",
    "menu": "border: 1px solid ${sel_bg}; background: ${bg}; color: ${fg};",
    "tool_bar": "color: ${fg}; background-color: ${bg}; border: 0;",
    "tool_button": "color: ${fg}; background: ${bg}; border: 0; border-radius: 2px;",
    "tool_button_pressed": "background: ${sel_bg};",
    "tool_button_selected": "background: ${sel_bg - #222222}; color: ${sel_fg}; border: 1px solid ${sel_bg};",
    "tab_bar": "background: ${bg - #222222};",
    "tab_selected": "padding: 0.5em; background: ${bg}; border: 1px solid ${bg}; border-bottom: 2px solid ${accent_color}; color: ${fg}; font-weight: 600;",
    "tab_unselected": "border: 1px solid ${bg}; border-bottom: 2px solid ${bg - #222222}; padding: 0.5em; background: ${bg - #222222}; color: ${fg - #333333};",
    "search_bar": "background: ${edit_bg}; color: ${edit_fg}; border: 1px solid ${alt_bg}; margin: 2px;",
    "search_bar_focused": "border: 1px solid ${sel_bg};",
    "item_selected": "background: ${sel_bg}; color: ${sel_fg};",
    "notification": "background: ${notification_bg}; color: ${notification_fg};",
    "tooltip": "background: ${alt_bg}; color: ${fg}; border: 1px solid ${sel_bg};"
  }
}
